PORT=5000

# One or more allowed frontend origins, comma-separated (no trailing slash).
# Example: http://localhost:3000,http://localhost:3002
FRONTEND_URL=http://localhost:3000

JWT_SECRET=replace_with_a_long_random_secret

DB_HOST=localhost
DB_PORT=5432
DB_NAME=loan_management
DB_USER=postgres
DB_PASSWORD=your_real_password
DB_DIALECT=postgres

# Used ONLY by `npm run db:seed:admin` to create the first admin account.
# Never commit real values. The password must be 8-72 characters.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
